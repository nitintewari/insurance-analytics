  create or replace view `insurance-analytics-498723`.`ncd_dev_staging`.`stg_agents`
  OPTIONS()
  as -- stg_agents.sql
-- Cleans and standardizes raw agent data from the source system.
-- One row per agent. Casts types, standardizes tier labels, flags inactive agents.

with source as (
    select * from `insurance-analytics-498723`.`ncd_dev_raw`.`agents`
),

renamed as (
    select
        agent_id,
        trim(agent_name)                        as agent_name,
        trim(agency_name)                       as agency_name,
        upper(state)                            as state,
        lower(email)                            as email,
        phone,
        cast(hire_date as date)                 as hire_date,
        cast(is_active as bool)                 as is_active,
        lower(tier)                             as tier,

        -- derived
        date_diff(current_date(), cast(hire_date as date), month)
                                                as months_tenure,
        case
            when lower(tier) = 'platinum' then 4
            when lower(tier) = 'gold'     then 3
            when lower(tier) = 'silver'   then 2
            else 1
        end                                     as tier_rank

    from source
)

select * from renamed;


[0m20:29:26.091508 [debug] [Thread-2 (]: On model.ncd_insurance_analytics.stg_cancellations: /* {"app": "dbt", "dbt_version": "1.11.11", "profile_name": "ncd_insurance_analytics", "target_name": "dev", "node_id": "model.ncd_insurance_analytics.stg_cancellations"} */


  create or replace view `insurance-analytics-498723`.`ncd_dev_staging`.`stg_cancellations`
  OPTIONS()
  as -- stg_cancellations.sql
-- Cleans cancellation records. Adds churn category and early-cancel flag.

with source as (
    select * from `insurance-analytics-498723`.`ncd_dev_raw`.`cancellations`
),

renamed as (
    select
        cancellation_id,
        policy_id,
        member_id,
        agent_id,
        cast(cancellation_date as date)         as cancellation_date,
        lower(cancellation_reason)              as cancellation_reason,
        cast(months_active as int64)            as months_active,
        cast(lifetime_value as numeric)         as lifetime_value,
        carrier,
        plan_type,
        cast(was_payment_failure as bool)       as was_payment_failure,

        -- derived
        case
            when lower(cancellation_reason) = 'non_payment'    then 'involuntary'
            when lower(cancellation_reason) = 'deceased'       then 'involuntary'
            else 'voluntary'
        end                                     as churn_type,

        -- early cancellation = within first 3 months
        case
            when cast(months_active as int64) <= 3 then true
            else false
        end                                     as is_early_cancel,

        extract(year  from cast(cancellation_date as date))     as cancel_year,
        extract(month from cast(cancellation_date as date))     as cancel_month,
        format_date('%Y-%m', cast(cancellation_date as date))   as cancel_period

    from source
)

select * from renamed;


[0m20:29:26.091769 [debug] [Thread-4 (]: On model.ncd_insurance_analytics.stg_payments: /* {"app": "dbt", "dbt_version": "1.11.11", "profile_name": "ncd_insurance_analytics", "target_name": "dev", "node_id": "model.ncd_insurance_analytics.stg_payments"} */


  create or replace view `insurance-analytics-498723`.`ncd_dev_staging`.`stg_payments`
  OPTIONS()
  as -- stg_payments.sql
-- Cleans payment records. Adds days-to-pay, failure flags, and period keys.

with source as (
    select * from `insurance-analytics-498723`.`ncd_dev_raw`.`payments`
),

renamed as (
    select
        payment_id,
        policy_id,
        member_id,
        cast(due_date as date)                  as due_date,
        cast(paid_date as date)                 as paid_date,
        cast(amount_due as numeric)             as amount_due,
        cast(amount_paid as numeric)            as amount_paid,
        lower(payment_status)                   as payment_status,
        lower(payment_method)                   as payment_method,
        carrier,
        plan_type,

        -- derived
        case
            when lower(payment_status) = 'failed' then true
            else false
        end                                     as is_failed,

        case
            when lower(payment_status) = 'paid_late' then true
            else false
        end                                     as is_late,

        case
            when paid_date is not null
            then date_diff(cast(paid_date as date), cast(due_date as date), day)
            else null
        end                                     as days_to_pay,

        cast(amount_due - amount_paid as numeric)
                                                as payment_gap,

        extract(year  from cast(due_date as date))   as due_year,
        extract(month from cast(due_date as date))   as due_month,
        format_date('%Y-%m', cast(due_date as date)) as due_period

    from source
)

select * from renamed;


